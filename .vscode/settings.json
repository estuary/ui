{
    // Formatting is delegated to the Prettier extension, which reads
    // .prettierrc.cjs and .prettierignore from the repo root.
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    // Prettier owns these languages. Languages it does not handle (shell
    // scripts, for example) are left alone so whatever formatter the
    // developer has installed still applies.
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[graphql]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

    // Never fall back to Prettier's built-in defaults when a config is
    // missing; the repo config is the only source of truth.
    "prettier.requireConfig": true,

    // ESLint 8 with .eslintrc.cjs -- opt out of the extension's flat config
    // default so it picks up the eslintrc file.
    "eslint.useFlatConfig": false,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],

    // Mirrors tabWidth/useTabs/endOfLine from .prettierrc.cjs so untouched
    // regions and new files match before Prettier ever runs.
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.eol": "\n",

    // Use the TypeScript version pinned in package.json rather than the one
    // bundled with VS Code.
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "js/ts.tsdk.promptToUseWorkspaceVersion": true
}
